{
  "name": "@axiomchess/analyzer",
  "version": "0.1.0",
  "private": true,
  "description": "Stockfish workers, feature extraction, and calibrated scoring for AxiomChess",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas/analysis-result-v1.json": "./schemas/analysis-result-v1.json"
  },
  "files": [
    "dist",
    "schemas",
    "NOTICE",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json --pretty false",
    "lint": "eslint . && tsc -p tsconfig.json --noEmit --pretty false",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "engine:download": "node scripts/download-stockfish.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.19.1",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^3.2.4"
  }
}
